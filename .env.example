# OpenAI-compatible upstream provider
PROVIDER_BASE_URL=https://provider.example/v1
PROVIDER_API_KEY=replace-with-provider-api-key
PROVIDER_MODEL=replace-with-provider-model-id

# BYV gateway listener
HOST=127.0.0.1
PORT=8787
# Optional. When omitted, a local key is generated in .byv-gateway-token.
GATEWAY_API_KEY=

# Optional request limits
PROVIDER_TIMEOUT_MS=300000
MAX_BODY_BYTES=10485760
MAX_OUTPUT_CHARS=2097152
MAX_PROMPT_CHARS=120000
MAX_PENDING_REQUESTS=8
MAX_RECOVERY_ATTEMPTS=2

# Optional exact CORS origin allowlist, comma-separated
CORS_ALLOWED_ORIGINS=

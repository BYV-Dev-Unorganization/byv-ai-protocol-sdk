# OpenAI-compatible upstream provider
PROVIDER_BASE_URL=https://provider.example/v1
PROVIDER_API_KEY=replace-with-provider-api-key
PROVIDER_MODEL=replace-with-provider-model-id

# Optional OpenAI-compatible native function calling (default: false).
# BYV Format Block is the primary tool-call protocol.
PROVIDER_NATIVE_TOOL_CALLING=false

# This branch uses text-protocol inference; provider-native function calling is disabled by default.
# Variant A hides tool metadata; Variant B lists it as reference-only.
NO_TOOL_EXPERIMENT_VARIANT=A

# Optional OpenAI-compatible extension; off by default for broad provider compatibility.
# Enable only when the configured provider supports the reasoning_effort parameter.
PROVIDER_NATIVE_REASONING_EFFORT=false

# Some providers require reasoning_effort=none for required or named native tool choices.
# This workaround is provider-capability opt-in, never inferred from a model name.
PROVIDER_DISABLE_REASONING_FOR_REQUIRED_TOOLS=false

# Optional model limits. Leave blank to discover them from provider model metadata.
# Explicit values override provider metadata. Use the actual upstream model's limits.
PROVIDER_CONTEXT_WINDOW_TOKENS=
PROVIDER_MAX_INPUT_TOKENS=
PROVIDER_MAX_OUTPUT_TOKENS=

# Model metadata discovery and capability cache
PROVIDER_MODEL_METADATA_TIMEOUT_MS=5000
PROVIDER_CAPABILITIES_CACHE_MS=300000
# Tokens reserved for provider formatting/estimation variance when a context window is known.
CONTEXT_WINDOW_SAFETY_TOKENS=1024

# BYV gateway listener
HOST=127.0.0.1
PORT=8787
# Optional. When omitted, a local key is generated in .byv-gateway-token.
GATEWAY_API_KEY=

# Optional upstream quota protection (0 = disabled). Set these to match your provider plan.
# Example FREE tier: 6 requests/minute and 1 concurrent request.
PROVIDER_MAX_REQUESTS_PER_MINUTE=0
PROVIDER_MAX_CONCURRENT_REQUESTS=0

# Optional request limits
PROVIDER_TIMEOUT_MS=300000
MAX_PROVIDER_RETRIES=1
STREAM_PING_INTERVAL_MS=15000
MAX_BODY_BYTES=10485760
MAX_OUTPUT_CHARS=2097152
# Maximum assembled system prompt in characters (not tokens); provider context budgeting is enforced separately.
MAX_PROMPT_CHARS=4000000

# Generic budget for Claude Code autocompaction requests across OpenAI-compatible providers.
# Provider model metadata further lowers these limits when smaller context/output limits are detected.
COMPACTION_MAX_INPUT_TOKENS=32768
COMPACTION_MAX_OUTPUT_TOKENS=8192
COMPACTION_MAX_SYSTEM_CHARS=8000
MAX_PENDING_REQUESTS=8
MAX_RECOVERY_ATTEMPTS=2

# Optional exact CORS origin allowlist, comma-separated
CORS_ALLOWED_ORIGINS=

# Structured local JSONL diagnostics. Request/response bodies are omitted by default.
LOG_CAPTURE_CONTENT=false
LOG_MAX_FILE_BYTES=10485760
LOG_ROTATION_FILES=3
